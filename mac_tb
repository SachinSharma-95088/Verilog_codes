```verilog
`timescale 1ns/1ps

module mac_tb();

    reg clk, rst, enable;
    reg [7:0] in_A;
    wire [7:0] acc;

    mac uut(clk, rst, enable, in_A, acc);

    always #5 clk = ~clk;

    initial begin
        // Initialize signals
        clk = 0;
        rst = 0;
        enable = 0;
        in_A = 8'b0;

        // Generate waveform
        $dumpfile("mac.vcd");
        $dumpvars(0, mac_tb);

        // Monitor simulation
        $monitor("Time=%0t | rst=%b | enable=%b | in_A=%0d | acc=%0d",
                 $time, rst, enable, in_A, acc);

        // Hold active-low reset for exactly 65 ns
        #65;
        rst = 1;

        // Cycle 1: enable = 1, in_A = 2
        @(negedge clk);
        enable = 1;
        in_A = 8'd2;

        // Cycle 2: enable = 1, in_A = 5
        @(negedge clk);
        enable = 1;
        in_A = 8'd5;

        // Cycle 3: enable = 0, in_A = 10
        @(negedge clk);
        enable = 0;
        in_A = 8'd10;

        // Cycle 4: enable = 1, in_A = 3
        @(negedge clk);
        enable = 1;
        in_A = 8'd3;

        // Allow MAC to process Cycle 4
        @(posedge clk);
        #1;

        $display("Final accumulator = %0d", acc);

        // Prevent further accumulation and show final value
        enable = 0;
        #40;

        $finish;
    end

endmodule
